# Fast local gate. Deliberately does NOT run the test suite: these specs drive shared, stateful
# UAT accounts for 45-75 minutes each and permanently advance their journey position, so running
# them per commit would be both unusable and destructive. `husky init` writes `npm test` here by
# default — that is why this file is explicit about not doing that.

echo "🔍 Running ESLint on staged files..."
npx lint-staged

echo "📝 Running TypeScript type check..."
npx tsc --noEmit

echo "🧭 Running framework rule engine on staged files..."
npm run rules:staged

echo "✅ Pre-commit checks passed!"
