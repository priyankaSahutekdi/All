# Environment Configuration
BASE_URL=https://all-uat.theall.ai
API_BASE_URL=https://all-uat.theall.ai

# Test Credentials
TEST_USERNAME=
TEST_PASSWORD=

# New AXL Guest login: grade selected in the Grade dropdown (options 1..8)
GRADE=2

# Vision provider for M-series VQA activities (M4 S1 / TC-024 "speak the correct answer").
# No key committed: TC-024 SKIPS until VISION_API_KEY is set. Provider-agnostic.
#   VISION_PROVIDER  anthropic | openai            (default: anthropic)
#   VISION_API_KEY   your vision API key           (required to run the VQA S-node tests)
#   VISION_MODEL     model id                       (default: claude-sonnet-5 / gpt-4o)
#   VISION_ENDPOINT  override HTTP endpoint          (optional)
VISION_PROVIDER=anthropic
VISION_API_KEY=
VISION_MODEL=claude-sonnet-5

# API Configuration
API_TIMEOUT=30000

# Logging
LOG_LEVEL=INFO

